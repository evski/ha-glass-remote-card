<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Watch remote Info.plist. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Remote</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Single-target watch app with no iPhone companion. -->
	<key>WKApplication</key>
	<true/>
	<key>WKWatchOnly</key>
	<true/>
	<!-- WKRunsIndependentlyOfCompanionApp removed 2026-10-16:
	     watchOS refuses to install an app that defines it alongside WKWatchOnly. -->
	<!-- HA is normally reached over HTTPS (homeassistant.example.com). This only
	     additionally allows plain-http LAN addresses such as http://192.168.x.x:8123. -->
	<!-- First-launch prefill from Config/Secrets.xcconfig (empty if absent).
	     Copied into the Keychain once, then ignored; Settings can still change or forget the values. -->
	<key>HABaseURL</key>
	<string>$(HA_BASE_URL)</string>
	<key>HAToken</key>
	<string>$(HA_TOKEN)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
