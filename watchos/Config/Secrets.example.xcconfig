// Copy to Config/Secrets.xcconfig (gitignored) and fill in. NEVER commit the real file.
// xcconfig treats "//" as a comment, so write the URL with $() between the slashes,
// or just give the bare host (the app adds https://).
HA_BASE_URL = https:/$()/homeassistant.example.com
HA_TOKEN = paste-long-lived-access-token-here
